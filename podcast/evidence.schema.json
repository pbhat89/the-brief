{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morning companion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "generated_at",
    "sources"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "url",
          "retrieved_at",
          "published_at",
          "original_published_at",
          "access",
          "claim",
          "event_id",
          "primary_urls",
          "transcript",
          "replay"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "x",
              "everyday_ai",
              "primary",
              "news",
              "weather",
              "air_quality"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "original_published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "access": {
            "enum": [
              "accessible",
              "blocked",
              "error"
            ]
          },
          "claim": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "transcript": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "url",
              "segments"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "segments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "replay": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "observation": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "observed_at",
              "region",
              "metric",
              "value",
              "units"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "region": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "units": {
                "type": "string"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "access": {
                  "const": "accessible"
                },
                "kind": {
                  "const": "everyday_ai"
                }
              }
            },
            "then": {
              "properties": {
                "transcript": {
                  "type": "object"
                },
                "replay": {
                  "const": false
                },
                "original_published_at": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "access": {
                  "const": "accessible"
                },
                "kind": {
                  "enum": [
                    "weather",
                    "air_quality"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "observation"
              ],
              "properties": {
                "observation": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    }
  }
}
