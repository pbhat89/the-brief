  "fun_fact": {
    "headline": "Babies are born with about 300 bones but adults have 206",
    "body": "A newborn baby has about 300 bones, but a fully grown adult has only 206. As a child grows, dozens of small, partly cartilaginous bones fuse together — most dramatically in the skull, spine and pelvis — which is why the adult count ends up so much lower.",
    "source": "Cleveland Clinic; Healthline",
    "fun_fact_id": "funfact-2e639700",
    "topic": "human body",
    "topic_key": "human bones"
  },
  "puzzle": {
    "type": "quantitative",
    "title": "Every Digit Counts",
    "title_key": "every-digit-counts",
    "body": "A book's pages are numbered starting at 1. Printing all the page numbers took exactly 1,875 digits. How many pages does the book have?",
    "approach": "Count digits in the one-, two- and three-digit page bands, then work backwards.",
    "answer": "661 pages. Pages 1-9 use 9 digits; 10-99 use 180 (total 189); the remaining 1,686 digits at 3 each give 562 three-digit pages (100-661).",
    "puzzle_hash": "0883135e"
  },
