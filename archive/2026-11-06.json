  "fun_fact": {
    "headline": "Your body is faintly luminous",
    "body": "Your body is faintly luminous. Human skin gives off an ultraweak glow — visible-light photons released as a by-product of metabolism — that is roughly a thousand times too dim for the naked eye to see. A 2009 Japanese study that imaged volunteers in total darkness found the emission rises and falls over the day, peaking in the late afternoon and tracing the face most brightly.",
    "source": "Kobayashi et al. 2009 (PLoS ONE); Scientific American",
    "fun_fact_id": "funfact-c3da8e49",
    "topic": "biology",
    "topic_key": "human bioluminescence"
  },
  "puzzle": {
    "type": "visual",
    "title": "Painted Cube",
    "title_key": "painted-cube",
    "body": "A 3x3x3 cube is built from 27 identical small cubes. Its entire outer surface is painted red, then it is taken apart into the 27 small cubes. How many have red paint on exactly two faces, and how many have no paint at all?",
    "approach": "Sort the 27 small cubes by position — corner, edge, face, or centre — then count.",
    "answer": "12 cubes have two painted faces (the edge cubes); 1 cube (the centre) has none. 8 corners have 3 faces, 6 face-centres have 1, 8+12+6+1=27.",
    "puzzle_hash": "0b3c0b72"
  },
  "word_puzzle": {
    "type": "grouping",
    "title": "Birds of a Feather",
    "title_key": "birds-of-a-feather",
    "body": "Sort 16 words into four groups of four: SKY OAK BASE SUN / ROYAL VOLLEY ASH MOON / FOOT NAVY ELM SPOT / TEAL PINE BASKET FLASH.",
    "approach": "Four hidden groups of four; one word fits two groups.",
