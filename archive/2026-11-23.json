  "fun_fact": {
    "headline": "The first computer 'bug' was a literal moth found in the relay of Harvard's Mark II in 1947.",
    "body": "The word 'bug' for an engineering fault predates computers, but in 1947 operators of Harvard's Mark II found a literal one — a moth trapped in a relay. They taped it into the logbook beside the note 'First actual case of bug being found.' That page, moth still attached, now sits in the Smithsonian's National Museum of American History.",
    "source": "Smithsonian; National Geographic",
    "fun_fact_id": "funfact-2e2eb8a0",
    "topic": "tech",
    "topic_key": "computer bug"
  },
