  "fun_fact": {
    "headline": "A fair-weather cloud weighs about a million pounds",
    "body": "A typical fair-weather cumulus cloud weighs on the order of a million pounds — the US Geological Survey puts it near 1.1 million pounds, roughly the mass of 100 elephants. The water is spread across a cubic kilometre as droplets so tiny they stay aloft, and the cloud floats because the moist air holding it is still less dense than the drier air below.",
    "source": "US Geological Survey; Scientific American",
    "fun_fact_id": "funfact-93d9f775",
    "topic": "physics",
    "topic_key": "cloud"
  },
  "puzzle": {
    "type": "lateral",
    "title": "Left on the Lawn",
    "title_key": "left-on-the-lawn",
    "body": "One spring morning a gardener finds five lumps of coal, a carrot, and an old scarf lying together in the middle of the lawn. No person placed them there. There is no packaging, no footprints, and no tyre tracks anywhere nearby. How did these particular objects come to be arranged on the grass?",
    "approach": "The objects did not appear by magic or by a person's hand. Ask what could have held them together and then quietly disappeared.",
    "answer": "They are the leftovers of a snowman. Someone built a snowman using coal for eyes and buttons, a carrot for a nose, and a scarf; when the snow melted it left only the non-melting objects on the grass.",
    "puzzle_hash": "4c51aa44"
  },
  "word_puzzle": {
    "type": "anagram",
    "title": "Countries in Disguise",
    "title_key": "countries-in-disguise",
    "body": "Rearrange the letters of each ordinary word to reveal the name of a country: RAIN, MAIL, SERIAL, PENAL, PURE, LAITY.",
    "approach": "Each everyday English word is an anagram of a country's name — the very same letters, simply rearranged.",
    "answer": "RAIN->IRAN, MAIL->MALI, SERIAL->ISRAEL, PENAL->NEPAL, PURE->PERU, LAITY->ITALY.",
