  "fun_fact": {
    "headline": "Roman concrete can heal its own cracks",
    "body": "Ancient Roman concrete can heal its own cracks. When water seeps into a fracture it reacts with tiny lumps of unmixed lime, called lime clasts, to form fresh calcium carbonate that seals the gap — one reason 2,000-year-old Roman harbours and the Pantheon's dome still stand. MIT and Harvard researchers described the self-healing mechanism in the journal Science Advances in 2023.",
    "source": "Science Advances / Scientific American",
    "fun_fact_id": "funfact-70177979",
    "topic": "history",
    "topic_key": "roman concrete"
  },
  "puzzle": {
    "type": "visual",
    "title": "Ten-Coin Turnaround",
    "title_key": "ten-coin-turnaround",
    "body": "Ten coins form a triangle pointing up (rows of 1,2,3,4). Move exactly three coins so it points down.",
    "approach": "Work out which coins can stay put — only the three corners need to move.",
    "answer": "Move the three corner coins: the top coin becomes the new bottom tip, and the two bottom-corner coins move up to the ends of the second row to form the new four-coin top row. The inner seven coins never move. Minimum three moves.",
