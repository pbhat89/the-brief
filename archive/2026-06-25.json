  "fun_fact": {
    "headline": "Saturn is the only planet less dense than water",
    "body": "Saturn is the only planet in the Solar System less dense than water. Its average density is about 0.69 g/cm3 — roughly 30% lighter than water — so given a big enough bath it would float. The lightness comes from Saturn being made mostly of hydrogen and helium.",
    "source": "NASA, Encyclopaedia Britannica",
    "fun_fact_id": "funfact-e7bde46a",
    "topic": "space",
    "topic_key": "saturn"
  },
